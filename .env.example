# Copy this file to .env and fill in your credentials

AQUARIUS_BASE_URL=https://aquarius.portlandoregon.gov/api/v1
AQUARIUS_USERNAME=username
AQUARIUS_PASSWORD=password
OUTPUT_DIRECTORY=output/directory

# OPTIONAL: free key from https://api.waterdata.usgs.gov/signup
# Raises the USGS rate limit (~50 -> ~1,000 requests/hour).
# Delete this line or leave it blank to connect anonymously.
USGS_API_KEY=